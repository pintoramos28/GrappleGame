[ext_resource type="Script" uid="uid://du0c2qt8xb425" path="res://ai/tasks/is_enemy_kind.gd" id="4_is_kind"]
[ext_resource type="Script" uid="uid://n2uycxbgj81h" path="res://ai/tasks/is_target_in_attack_range.gd" id="5_in_attack_range"]
[ext_resource type="Script" uid="uid://cqrpikhwafp2j" path="res://ai/tasks/is_target_too_close.gd" id="6_too_close"]
[ext_resource type="Script" uid="uid://dy2jsxfuxouso" path="res://ai/tasks/is_target_too_far.gd" id="7_too_far"]
