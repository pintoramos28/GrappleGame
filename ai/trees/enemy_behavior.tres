[ext_resource type="Script" uid="uid://c3qt24o0givn5" path="res://ai/tasks/request_enemy_attack.gd" id="11_request_attack"]

[sub_resource type="BlackboardPlan" id="BlackboardPlan_sasvj"]

[sub_resource type="BTCondition" id="BTCondition_has_target_ranged"]
script = ExtResource("1_has_target")

[sub_resource type="BTCondition" id="BTCondition_is_ranged"]
script = ExtResource("4_is_kind")
enemy_kind = 1

[sub_resource type="BTAction" id="BTAction_face_ranged"]
script = ExtResource("2_face_target")

[sub_resource type="BTCondition" id="BTCondition_too_close"]
script = ExtResource("6_too_close")

[sub_resource type="BTAction" id="BTAction_move_away"]
script = ExtResource("10_move_away")

[sub_resource type="BTSequence" id="BTSequence_ranged_retreat"]
custom_name = "Retreat from target"
children = [SubResource("BTCondition_too_close"), SubResource("BTAction_move_away")]

[sub_resource type="BTCondition" id="BTCondition_too_far"]
script = ExtResource("7_too_far")

[sub_resource type="BTAction" id="BTAction_move_toward_ranged"]
script = ExtResource("9_move_toward")

[sub_resource type="BTSequence" id="BTSequence_ranged_approach"]
custom_name = "Approach ranged distance"
children = [SubResource("BTCondition_too_far"), SubResource("BTAction_move_toward_ranged")]

[sub_resource type="BTCondition" id="BTCondition_has_los_ranged"]
script = ExtResource("8_has_los")

[sub_resource type="BTCondition" id="BTCondition_in_range_ranged"]
script = ExtResource("5_in_attack_range")

[sub_resource type="BTAction" id="BTAction_stop_ranged_attack"]
script = ExtResource("3_stop_horizontal")

[sub_resource type="BTAction" id="BTAction_request_ranged_attack"]
script = ExtResource("11_request_attack")

[sub_resource type="BTSequence" id="BTSequence_ranged_attack"]
custom_name = "Ranged attack"
children = [SubResource("BTCondition_has_los_ranged"), SubResource("BTCondition_in_range_ranged"), SubResource("BTAction_stop_ranged_attack"), SubResource("BTAction_request_ranged_attack")]

[sub_resource type="BTAction" id="BTAction_stop_ranged"]
script = ExtResource("3_stop_horizontal")

[sub_resource type="BTSelector" id="BTSelector_ranged_position"]
custom_name = "Ranged positioning"
children = [SubResource("BTSequence_ranged_retreat"), SubResource("BTSequence_ranged_approach"), SubResource("BTSequence_ranged_attack"), SubResource("BTAction_stop_ranged")]

[sub_resource type="BTSequence" id="BTSequence_ranged_behavior"]
custom_name = "Ranged behavior"
children = [SubResource("BTCondition_has_target_ranged"), SubResource("BTCondition_is_ranged"), SubResource("BTAction_face_ranged"), SubResource("BTSelector_ranged_position")]

[sub_resource type="BTCondition" id="BTCondition_has_target_melee"]
script = ExtResource("1_has_target")

[sub_resource type="BTCondition" id="BTCondition_is_melee"]
script = ExtResource("4_is_kind")

[sub_resource type="BTAction" id="BTAction_face_melee"]
script = ExtResource("2_face_target")

[sub_resource type="BTCondition" id="BTCondition_in_range_melee"]
script = ExtResource("5_in_attack_range")

[sub_resource type="BTAction" id="BTAction_stop_melee_attack"]
script = ExtResource("3_stop_horizontal")

[sub_resource type="BTAction" id="BTAction_request_melee_attack"]
script = ExtResource("11_request_attack")

[sub_resource type="BTSequence" id="BTSequence_melee_attack"]
custom_name = "Melee attack"
children = [SubResource("BTCondition_in_range_melee"), SubResource("BTAction_stop_melee_attack"), SubResource("BTAction_request_melee_attack")]

[sub_resource type="BTAction" id="BTAction_move_toward_melee"]
script = ExtResource("9_move_toward")

[sub_resource type="BTSelector" id="BTSelector_melee_position"]
custom_name = "Melee positioning"
children = [SubResource("BTSequence_melee_attack"), SubResource("BTAction_move_toward_melee")]

[sub_resource type="BTSequence" id="BTSequence_melee_behavior"]
custom_name = "Melee behavior"
children = [SubResource("BTCondition_has_target_melee"), SubResource("BTCondition_is_melee"), SubResource("BTAction_face_melee"), SubResource("BTSelector_melee_position")]

[sub_resource type="BTAction" id="BTAction_stop_idle"]
script = ExtResource("3_stop_horizontal")

[sub_resource type="BTSequence" id="BTSequence_idle"]
custom_name = "Idle"
children = [SubResource("BTAction_stop_idle")]

[sub_resource type="BTSelector" id="BTSelector_root"]
custom_name = "Enemy behavior"
children = [SubResource("BTSequence_ranged_behavior"), SubResource("BTSequence_melee_behavior"), SubResource("BTSequence_idle")]

[resource]
description = "Vision-driven enemy behavior. Melee enemies chase and attack in range; ranged enemies maintain distance and fire through the attack HSM."
blackboard_plan = SubResource("BlackboardPlan_sasvj")
root_task = SubResource("BTSelector_root")
